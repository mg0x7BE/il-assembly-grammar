{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IL Assembly",
  "scopeName": "source.il",
  "fileTypes": ["il"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#bytearray" },
    { "include": "#directive" },
    { "include": "#label" },
    { "include": "#opcode-prefix" },
    { "include": "#opcode-control" },
    { "include": "#opcode" },
    { "include": "#storage-modifier" },
    { "include": "#type-builtin" },
    { "include": "#number-hex" },
    { "include": "#number-float" },
    { "include": "#number-integer" },
    { "include": "#assembly-ref" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.il",
      "match": "//.*$"
    },
    "string-double": {
      "name": "string.quoted.double.il",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.il" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.il" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.il",
          "match": "\\\\."
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.il",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.il" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.il" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.il",
          "match": "\\\\."
        }
      ]
    },
    "bytearray": {
      "begin": "\\b(bytearray)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.other.bytearray.il" },
        "2": { "name": "punctuation.section.parens.begin.il" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.il" }
      },
      "patterns": [
        { "include": "#comment" },
        {
          "name": "constant.numeric.hex.il",
          "match": "[0-9a-fA-F]{2}"
        }
      ]
    },

    "directive": {
      "patterns": [
        {
          "comment": "Structure directives",
          "name": "keyword.control.directive.il",
          "match": "(?<![.\\w])\\.(assembly|module|class|namespace|method|field|property|event)(?![.\\w])"
        },
        {
          "comment": "Method body directives",
          "name": "keyword.control.directive.il",
          "match": "(?<![.\\w])\\.(custom|maxstack|locals|entrypoint|try|catch|finally|filter|fault)(?![.\\w])"
        },
        {
          "comment": "Data & parameter directives",
          "name": "keyword.control.directive.il",
          "match": "(?<![.\\w])\\.(data|size|pack|override|param|permissionset)(?![.\\w])"
        },
        {
          "comment": "Property/event accessor directives",
          "name": "keyword.control.directive.il",
          "match": "(?<![.\\w])\\.(get|set|addon|removeon|fire|other)(?![.\\w])"
        },
        {
          "comment": "PE & assembly metadata directives",
          "name": "keyword.control.directive.il",
          "match": "(?<![.\\w])\\.(export|vtfixup|vtentry|zeroinit|emitbyte|corflags|subsystem|imagebase|stackreserve)(?![.\\w])"
        },
        {
          "comment": "Resource & file directives",
          "name": "keyword.control.directive.il",
          "match": "(?<![.\\w])\\.(file|hash|mresource|line|language)(?![.\\w])"
        },
        {
          "comment": "Constructor & version directives",
          "name": "keyword.control.directive.il",
          "match": "(?<![.\\w])\\.(ctor|cctor|ver|publickey|publickeytoken|culture|locale)(?![.\\w])"
        }
      ]
    },

    "label": {
      "match": "^\\s*([A-Za-z_$][A-Za-z_$0-9]*)\\s*(:)(?!:)",
      "captures": {
        "1": { "name": "entity.name.label.il" },
        "2": { "name": "punctuation.separator.label.il" }
      }
    },

    "opcode-prefix": {
      "name": "keyword.other.prefix.il",
      "match": "(?<![.\\w])(?:tail|volatile|unaligned|readonly|constrained|no)\\."
    },

    "opcode-control": {
      "patterns": [
        {
          "comment": "Unconditional branch",
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])br(?:\\.s)?(?![.\\w])"
        },
        {
          "comment": "Boolean branches",
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:brfalse|brtrue)(?:\\.s)?(?![.\\w])"
        },
        {
          "comment": "Comparison branches",
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:beq|bge|bgt|ble|blt)(?:\\.(?:s|un(?:\\.s)?))?(?![.\\w])"
        },
        {
          "comment": "Inequality branch",
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])bne\\.un(?:\\.s)?(?![.\\w])"
        },
        {
          "comment": "Call, return & switch",
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:switch|call(?:i|virt)?|ret|jmp|throw|rethrow)(?![.\\w])"
        },
        {
          "comment": "Exception handling flow",
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:leave(?:\\.s)?|endfinally|endfilter|endfault)(?![.\\w])"
        }
      ]
    },

    "opcode": {
      "patterns": [
        {
          "comment": "Load argument/local",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldarg(?:\\.[0-3s])?|ldarga(?:\\.s)?|ldloc(?:\\.[0-3s])?|ldloca(?:\\.s)?)(?![.\\w])"
        },
        {
          "comment": "Load constant",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldc\\.i4(?:\\.(?:[0-8]|m1|s))?|ldc\\.(?:i8|r[48])|ldstr|ldnull)(?![.\\w])"
        },
        {
          "comment": "Load field/element/object",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldfld|ldsfld|ldflda|ldsflda|ldelem(?:\\.(?:i[1248]?|u[1248]|r[48]|ref))?|ldelema|ldlen|ldobj)(?![.\\w])"
        },
        {
          "comment": "Load function pointer/token/indirect",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldftn|ldvirtftn|ldtoken|ldind\\.(?:i[1248]?|u[1248]|r[48]|ref))(?![.\\w])"
        },
        {
          "comment": "Store argument/local",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:starg(?:\\.s)?|stloc(?:\\.[0-3s])?)(?![.\\w])"
        },
        {
          "comment": "Store field/element/object/indirect",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:stfld|stsfld|stelem(?:\\.(?:i[1248]?|r[48]|ref))?|stobj|stind\\.(?:i[1248]?|r[48]|ref))(?![.\\w])"
        },
        {
          "comment": "Arithmetic",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:add|sub|mul)(?:\\.ovf(?:\\.un)?)?(?![.\\w])"
        },
        {
          "comment": "Division/remainder/negation",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:div(?:\\.un)?|rem(?:\\.un)?|neg)(?![.\\w])"
        },
        {
          "comment": "Bitwise & shift",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:and|or|xor|not|shl|shr(?:\\.un)?)(?![.\\w])"
        },
        {
          "comment": "Conversion",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:conv\\.(?:i[1248]?|u[1248]?|r[48]|r\\.un)|conv\\.ovf\\.(?:i[1248]?|u[1248]?)(?:\\.un)?)(?![.\\w])"
        },
        {
          "comment": "Comparison",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ceq|cgt(?:\\.un)?|clt(?:\\.un)?|ckfinite)(?![.\\w])"
        },
        {
          "comment": "Object model",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:newobj|newarr|initobj|castclass|isinst|box|unbox(?:\\.any)?|sizeof)(?![.\\w])"
        },
        {
          "comment": "Typed reference",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:mkrefany|refanytype|refanyval)(?![.\\w])"
        },
        {
          "comment": "Stack & misc",
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:pop|dup|nop|localloc|initblk|cpblk|cpobj|arglist|break)(?![.\\w])"
        }
      ]
    },

    "storage-modifier": {
      "patterns": [
        {
          "comment": "Access modifiers",
          "name": "storage.modifier.il",
          "match": "\\b(?:public|private|family|assembly|famorassem|famandassem|privatescope|compilercontrolled)\\b"
        },
        {
          "comment": "Method modifiers",
          "name": "storage.modifier.il",
          "match": "\\b(?:static|instance|virtual|abstract|sealed|newslot|final|hidebysig)\\b"
        },
        {
          "comment": "Special name & interop",
          "name": "storage.modifier.il",
          "match": "\\b(?:specialname|rtspecialname|pinvokeimpl|managed|unmanaged)\\b"
        },
        {
          "comment": "Implementation flags",
          "name": "storage.modifier.il",
          "match": "\\b(?:cil|forwardref|noinlining|aggressiveinlining|synchronized|runtime)\\b"
        },
        {
          "comment": "Type modifiers",
          "name": "storage.modifier.il",
          "match": "\\b(?:interface|enum|extends|implements|nested)\\b"
        },
        {
          "comment": "Layout & charset",
          "name": "storage.modifier.il",
          "match": "\\b(?:sequential|explicit|auto|ansi|unicode|autochar)\\b"
        },
        {
          "comment": "Field & misc modifiers",
          "name": "storage.modifier.il",
          "match": "\\b(?:beforefieldinit|serializable|initonly|literal|notserialized|extern|init)\\b"
        },
        {
          "comment": "Marshal & calling convention",
          "name": "storage.modifier.il",
          "match": "\\b(?:marshal|in|out|opt|at|bytearray|nullref|vararg|default)\\b"
        }
      ]
    },

    "type-builtin": {
      "name": "support.type.il",
      "match": "\\b(?:void|bool|char|int8|int16|int32|int64|float32|float64|native|unsigned|int|object|string|typedref|class|valuetype)\\b"
    },

    "number-hex": {
      "name": "constant.numeric.hex.il",
      "match": "\\b0[xX][0-9a-fA-F]+\\b"
    },
    "number-float": {
      "name": "constant.numeric.float.il",
      "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
    },
    "number-integer": {
      "name": "constant.numeric.integer.il",
      "match": "\\b[0-9]+\\b"
    },

    "assembly-ref": {
      "name": "entity.name.type.module.il",
      "match": "\\[[A-Za-z_][\\w.]*\\]"
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.accessor.il",
          "match": "::"
        },
        {
          "name": "punctuation.section.braces.begin.il",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.il",
          "match": "\\}"
        }
      ]
    }
  }
}
